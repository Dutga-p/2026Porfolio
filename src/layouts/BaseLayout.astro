---
import '../styles/global.css';
import { languages, type Lang } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';
import { personSchemaJson, themeScript } from '../lib/head-inline.js';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = 'es' } = Astro.props;

const canonicalURL = new URL(getLocalizedPath(lang), Astro.site);
const ogImageURL = new URL('/og-image.webp', Astro.site);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {
      Object.keys(languages).map((key) => (
        <link
          rel="alternate"
          hreflang={key}
          href={new URL(getLocalizedPath(key as Lang), Astro.site)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Ambos scripts salen de src/lib/head-inline.js, que es también de donde
        astro.config.mjs saca sus hashes CSP. No los escribas aquí a mano. */}
    <script type="application/ld+json" is:inline set:html={personSchemaJson} />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-accent-foreground"
    >
      {lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <slot />
  </body>
</html>
