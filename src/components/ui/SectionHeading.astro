---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className } = Astro.props;
---

<div class:list={['max-w-2xl', className]}>
  <p class="text-sm font-medium text-accent">{eyebrow}</p>
  <h2 class="mt-2 font-display text-3xl font-semibold text-text-primary sm:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-text-secondary">{description}</p>}
</div>
