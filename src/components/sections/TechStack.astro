---
import python from 'simple-icons/icons/python.svg?raw';
import react from 'simple-icons/icons/react.svg?raw';
import vuedotjs from 'simple-icons/icons/vuedotjs.svg?raw';
import typescript from 'simple-icons/icons/typescript.svg?raw';
import nodedotjs from 'simple-icons/icons/nodedotjs.svg?raw';
import laravel from 'simple-icons/icons/laravel.svg?raw';
import django from 'simple-icons/icons/django.svg?raw';
import flask from 'simple-icons/icons/flask.svg?raw';
import astro from 'simple-icons/icons/astro.svg?raw';
import nextdotjs from 'simple-icons/icons/nextdotjs.svg?raw';
import expo from 'simple-icons/icons/expo.svg?raw';
import postgresql from 'simple-icons/icons/postgresql.svg?raw';
import mysql from 'simple-icons/icons/mysql.svg?raw';
import docker from 'simple-icons/icons/docker.svg?raw';
import nginx from 'simple-icons/icons/nginx.svg?raw';
import linux from 'simple-icons/icons/linux.svg?raw';
import git from 'simple-icons/icons/git.svg?raw';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

// simple-icons has no AWS or React Native entry (Amazon/Meta restrict those
// brand marks), so those two render as text-only badges instead of icon + text.
const categories = [
    {
    label: t.techStack.categories.frontend,
    technologies: [
      { name: 'React', icon: react },
      { name: 'Next.js', icon: nextdotjs },
      { name: 'React Native', icon: null },
      { name: 'Vue.js', icon: vuedotjs },
      { name: 'Astro', icon: astro },
      { name: 'TypeScript', icon: typescript },
      { name: 'Expo', icon: expo },
    ],
  },
  {
    label: t.techStack.categories.backend,
    technologies: [
      { name: 'Python', icon: python },
      { name: 'Node.js', icon: nodedotjs },
      { name: 'Laravel', icon: laravel },
      { name: 'Django', icon: django },
      { name: 'Flask', icon: flask },
    ],
  },
  {
    label: t.techStack.categories.database,
    technologies: [
      { name: 'PostgreSQL', icon: postgresql },
      { name: 'MySQL', icon: mysql },
    ],
  },
  {
    label: t.techStack.categories.devops,
    technologies: [
      { name: 'Docker', icon: docker },
      { name: 'Nginx', icon: nginx },
      { name: 'Linux', icon: linux },
      { name: 'Git', icon: git },
    ],
  },
];

const withCurrentColor = (svg: string) => svg.replace('<svg ', '<svg fill="currentColor" ');
---

<section aria-label={t.techStack.title} class="border-y border-border py-16">
  <Container class="flex flex-col gap-10">
    <SectionHeading eyebrow={t.techStack.eyebrow} title={t.techStack.title} />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((category) => (
          <div class="flex flex-col gap-4 rounded-2xl border border-border bg-surface p-5">
            <h3 class="text-xs font-semibold tracking-wide text-text-muted uppercase">
              {category.label}
            </h3>

            <ul class="flex flex-wrap gap-2">
              {category.technologies.map((tech) => (
                <li class="flex items-center gap-2 rounded-full bg-bg px-3 py-1.5 text-sm font-medium whitespace-nowrap text-text-secondary">
                  {tech.icon && (
                    <span
                      class="h-4 w-4 shrink-0 text-text-muted [&>svg]:h-full [&>svg]:w-full"
                      set:html={withCurrentColor(tech.icon)}
                    />
                  )}
                  {tech.name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Container>
</section>
