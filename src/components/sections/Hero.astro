---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section id="home" class="hero relative overflow-hidden">
  <Container class="flex min-h-[85vh] flex-col justify-center gap-6 py-20">
    <p
      class="hero-badge inline-flex w-fit items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-xs text-text-secondary"
    >
      <span class="hero-badge-dot h-1.5 w-1.5 rounded-full bg-accent"></span>
      {t.hero.availability}
    </p>

    <h1
      class="hero-title max-w-3xl font-display text-4xl leading-tight font-semibold text-text-primary sm:text-6xl lg:text-7xl"
    >
      {t.hero.titlePrefix}{' '}
      <span class="text-text-secondary">{t.hero.titleSuffix}</span>
    </h1>

    <p class="hero-description max-w-xl text-lg text-text-secondary">
      {t.hero.description}
    </p>

    <div class="hero-ctas flex flex-wrap gap-4">
      <Button href="#projects" variant="primary">{t.hero.ctaProjects}</Button>
      <Button href="/CV/CV_David_Ordonez_2026.pdf" variant="secondary" download>
        {t.hero.ctaCV}
      </Button>
      <Button href="#contact" variant="secondary">{t.hero.ctaContact}</Button>
    </div>
  </Container>
</section>
