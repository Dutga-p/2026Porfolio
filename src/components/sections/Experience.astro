---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const experience = (
  await getCollection('experience', ({ id }) => id.startsWith(`${lang}/`))
).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" class="py-24">
  <Container class="flex flex-col gap-12">
    <SectionHeading eyebrow={t.experience.eyebrow} title={t.experience.title} />

    <ol class="flex flex-col gap-10 border-l border-border pl-8">
      {
        experience.map((item) => (
          <li class="relative">
            <span class="absolute -left-[calc(2rem+5px)] top-1.5 h-2.5 w-2.5 rounded-full bg-accent" />

            <p class="text-xs text-text-muted">
              {item.data.startDate} — {item.data.endDate ?? t.experience.present}
            </p>

            <h3 class="mt-1 font-display text-lg font-semibold text-text-primary">
              {item.data.role}
            </h3>
            <p class="text-sm text-accent">{item.data.organization}</p>

            <ul class="mt-3 flex flex-col gap-1.5">
              {item.data.achievements.map((achievement) => (
                <li class="flex items-start gap-2 text-sm text-text-secondary">
                  <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-text-muted" />
                  {achievement}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
