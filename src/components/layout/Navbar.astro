---
import Container from '../ui/Container.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations, getLocalizedPath, getAlternateLang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const alternateLang = getAlternateLang(lang);

const links = [
  { href: '#home', label: t.nav.inicio },
  { href: '#projects', label: t.nav.proyectos },
  { href: '#about', label: t.nav.sobreMi },
  { href: '#experience', label: t.nav.experiencia },
  { href: '#contact', label: t.nav.contacto },
];
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur-md">
  <Container class="flex items-center justify-between py-4">
    <a href={getLocalizedPath(lang)} class="font-display text-lg font-semibold text-text-primary">
      David<span class="text-accent">.dev</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-text-secondary transition-colors hover:text-text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={getLocalizedPath(alternateLang)}
        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-xs font-medium text-text-secondary transition-colors hover:border-accent hover:text-text-primary"
        aria-label={`Switch to ${alternateLang === 'en' ? 'English' : 'Español'}`}
      >
        {alternateLang.toUpperCase()}
      </a>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar tema"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-text-secondary transition-colors hover:border-accent hover:text-text-primary"
      >
        <svg
          class="icon-sun h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg
          class="icon-moon h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-text-secondary md:hidden"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </Container>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-border px-6 py-4 md:hidden"
    aria-label="Navegación móvil"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="rounded-md px-2 py-2 text-sm text-text-secondary transition-colors hover:bg-surface hover:text-text-primary"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  const closeMenu = (returnFocus: boolean) => {
    mobileMenu?.classList.add('hidden');
    mobileMenu?.classList.remove('flex');
    menuToggle?.setAttribute('aria-expanded', 'false');
    if (returnFocus) menuToggle?.focus();
  };

  const getFocusable = () =>
    Array.from(mobileMenu?.querySelectorAll<HTMLElement>('a, button') ?? []);

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('flex');
    mobileMenu?.classList.toggle('hidden');
    menuToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    if (isOpen) getFocusable()[0]?.focus();
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => closeMenu(false));
  });

  // Keep keyboard focus inside the open mobile menu (Tab/Shift+Tab cycle
  // between its first and last focusable item) and let Escape close it and
  // return focus to the toggle button — required so trapping focus never
  // becomes a keyboard trap (WCAG 2.1.2 / 2.4.3).
  mobileMenu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu(true);
      return;
    }

    if (event.key !== 'Tab') return;

    const focusable = getFocusable();
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
