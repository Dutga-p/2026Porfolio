---
import Container from '../ui/Container.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const links = [
  { href: '#projects', label: t.nav.proyectos },
  { href: '#about', label: t.nav.sobreMi },
  { href: '#experience', label: t.nav.experiencia },
  { href: '#contact', label: t.nav.contacto },
];

const socials = [
  { href: 'https://github.com/Dutga-p', label: 'GitHub' },
  {
    href: 'https://www.linkedin.com/in/david-ord%C3%B3%C3%B1ez-mar%C3%ADn-26a504256/',
    label: 'LinkedIn',
  },
  { href: 'mailto:contacto@dcom.agency', label: 'Email' },
];
---

<footer class="border-t border-border">
  <Container class="py-12">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <a href={getLocalizedPath(lang)} class="font-display text-lg font-semibold text-text-primary">
          David<span class="text-accent">.dev</span>
        </a>
        <p class="mt-3 text-sm text-text-secondary">
          {t.footer.tagline}
        </p>
      </div>

      <nav class="flex flex-col gap-2" aria-label="Enlaces del sitio">
        {
          links.map((link) => (
            <a href={link.href} class="text-sm text-text-secondary transition-colors hover:text-text-primary">
              {link.label}
            </a>
          ))
        }
      </nav>

      <nav class="flex flex-col gap-2" aria-label="Redes sociales">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-text-secondary transition-colors hover:text-text-primary"
            >
              {social.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-10 flex flex-col-reverse items-center justify-between gap-4 border-t border-border pt-6 text-xs text-text-muted md:flex-row">
      <p>© {year} — {t.footer.rights}</p>
      <p>{t.footer.builtWith}</p>
    </div>
  </Container>
</footer>
